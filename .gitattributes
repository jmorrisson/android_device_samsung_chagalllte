# Device trees are consumed on Linux; keep every text file LF no matter
# what the local git configuration says (core.autocrlf=true is common on Windows).
* text=auto eol=lf

# Shell scripts must never gain CRLF.
*.sh text eol=lf
*.mk text eol=lf
*.bp text eol=lf
*.rc text eol=lf
*.xml text eol=lf
*.txt text eol=lf
